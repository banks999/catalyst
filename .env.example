# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# DEMO_MODE controls which pipeline runs.
#   mock -> fully offline. Filters an in-app company list in pure Python.
#           No network, no API keys needed. Instant.
#   real -> live pipeline: Groq-hosted LLM + Firecrawl web search and scraping.
# ---------------------------------------------------------------------------
DEMO_MODE=mock

# --- Model (real mode only) -------------------------------------------------
# Groq's OpenAI-compatible endpoint. Any OpenAI-compatible base URL works.
GROQ_URL=https://api.groq.com/openai/v1
MODEL_ID=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here

# --- Web search + scraping (real mode only) ---------------------------------
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# --- Session persistence ----------------------------------------------------
# Optional. If unreachable, the app still runs; only saved-session history is lost.
POSTGRES_URL=postgresql://user:password@localhost:5432/your_db

# --- Optional tracing --------------------------------------------------------
# Off by default: a slow or unreachable tracing endpoint can stall every agent step.
ENABLE_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chemical_lead_generation
